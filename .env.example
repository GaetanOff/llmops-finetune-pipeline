# Model Configuration
MODEL_NAME=TinyLlama/TinyLlama-1.1B-Chat-v1.0
MODEL_PATH=./models/finetuned
MAX_LENGTH=512
BATCH_SIZE=4
LEARNING_RATE=2e-4
NUM_EPOCHS=3

# LoRA Configuration
LORA_R=16
LORA_ALPHA=32
LORA_DROPOUT=0.05

# MLflow Configuration
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=llmops-finetuning
MLFLOW_ENABLE_SYSTEM_METRICS_LOGGING=true

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=2
API_RELOAD=false

# Supabase Configuration (for dataset and metrics storage)
SUPABASE_URL=your-supabase-url
SUPABASE_KEY=your-supabase-anon-key

# DVC Configuration
DVC_REMOTE=s3://your-bucket/dvc-storage

# Monitoring Configuration
ENABLE_MONITORING=true
DRIFT_DETECTION_WINDOW=100

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
